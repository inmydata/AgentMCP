# Settings for the live integration tests in tests/integration/.
# Copy to .env.test (git-ignored) and fill in the keys for the modes you use.
#
# The local hostname must point at your local API (127.0.0.1) in your hosts file.
# Select the test server with --integration-target=test.

LOCAL_INMYDATA_API_KEY=
LOCAL_INMYDATA_TENANT=dev
LOCAL_INMYDATA_SERVER=inmydata.com
LOCAL_INMYDATA_CALENDAR=Default

TEST_INMYDATA_API_KEY=
TEST_INMYDATA_TENANT=test
TEST_INMYDATA_SERVER=test-inmydata.com
TEST_INMYDATA_CALENDAR=Default
