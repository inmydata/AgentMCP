# Settings for the live integration tests in tests/integration/.
# Copy to .env.test (git-ignored) and fill in the API key.
#
# The SDK calls https://<INMYDATA_TENANT>.<INMYDATA_SERVER>/..., so the
# defaults below reach https://dev.inmydata.com. That hostname must point at
# your local copy of the API (127.0.0.1) in your hosts file; the tests refuse
# to run if it resolves anywhere else.

INMYDATA_API_KEY=your_dev_api_key_here
INMYDATA_TENANT=dev
INMYDATA_SERVER=inmydata.com
INMYDATA_CALENDAR=Default
